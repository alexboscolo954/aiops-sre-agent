# Copy to .env (gitignored).
SQUERO_MODEL=anthropic:claude-sonnet-5-5
SQUERO_MODEL_API_KEY=
# Keys not scoped to a workspace need: SQUERO_MODEL_HEADERS={"anthropic-workspace-id": "wrkspc_..."}
# Clusters, namespaces, Prometheus and actions live in each Contract's contract.yaml.
SQUERO_CONTRACTS_DIR=demo/contracts

# Copy to .env (gitignored).
AIOPS_MODEL=anthropic:claude-sonnet-5-5
AIOPS_MODEL_API_KEY=
# Keys not scoped to a workspace need: AIOPS_MODEL_HEADERS={"anthropic-workspace-id": "wrkspc_..."}
# Clusters, namespaces, Prometheus and actions live in each Contract's contract.yaml.
AIOPS_CONTRACTS_DIR=demo/contracts

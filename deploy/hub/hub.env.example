# Copy to hub.env (the Hub reads it). Never commit it.
SQUERO_APPROVER_TOKEN=
SQUERO_MODEL_API_KEY=
# SQUERO_MODEL=anthropic:claude-sonnet-5-5
# SQUERO_MODEL_EFFORT=medium   # low | medium | high | xhigh | max; unset: the model's default
# SQUERO_SLACK_BOT_TOKEN=xoxb-...    # deploy/slack-app.yaml; channels are per Contract
# SQUERO_SLACK_APP_TOKEN=xapp-...    # approve / reject buttons (Socket Mode)
# SQUERO_SLACK_OPERATOR_ID=U...      # the only Slack user whose clicks decide
# SQUERO_CONSOLE_OPERATORS=["you@example.com"]  # web console: Tailscale logins (via tailscale serve)
# SQUERO_CONSOLE_URL=https://hub.tailnet.ts.net  # the weekly Sizing digest links its Workloads page
# SQUERO_MCP_TOKEN=  # the Hub MCP server at /mcp/: 32+ characters (openssl rand -hex 32), needs SQUERO_CONSOLE_OPERATORS
# SQUERO_CONTRACTS_REPO=owner/squero-contracts  # propose_change opens pull requests there
# SQUERO_CONTRACTS_TOKEN=  # fine-grained, that repo only: Contents + Pull requests read/write
# Prices for costs and budgets, $ per million tokens (check your provider's page):
# SQUERO_MODEL_PRICES={"anthropic:claude-sonnet-5-5": {"input": 2, "output": 10}, "anthropic:claude-haiku-5-5": {"input": 0.10, "output": 0.50, "long": {"over": 100000, "input": 0.50, "output": 2.50}}}
# Similar incidents by meaning, on a gateway: the model's (SQUERO_MODEL_BASE_URL) or its own,
# which a model called directly needs (Anthropic has no embeddings API). Price it as
# {"openai/text-embedding-3-small": {"input": 0.02, "output": 0}} in SQUERO_MODEL_PRICES:
# SQUERO_EMBEDDING_MODEL=openai/text-embedding-3-small
# SQUERO_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# SQUERO_EMBEDDING_API_KEY=

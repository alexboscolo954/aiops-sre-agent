{
  "mcpServers": {
    "k8s-triage": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/squero", "squero", "mcp", "kubernetes", "--contract", "demo-shop"],
      "env": {
        "SQUERO_CONTRACTS_DIR": "/path/to/contracts",
        "SOPS_AGE_KEY_FILE": "/path/to/age/keys.txt"
      }
    },
    "runbooks": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/squero", "squero", "mcp", "runbooks", "--contract", "demo-shop"],
      "env": {
        "SQUERO_CONTRACTS_DIR": "/path/to/contracts",
        "SOPS_AGE_KEY_FILE": "/path/to/age/keys.txt"
      }
    }
  }
}

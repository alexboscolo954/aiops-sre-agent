  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contracts": {
      "get": {
        "operationId": "contracts_api_v1_contracts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ContractSummary"
                  },
                  "title": "Response Contracts Api V1 Contracts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Contracts"
      }
    },
    "/api/v1/contracts/{contract_id}/cost": {
      "get": {
        "operationId": "cost_api_v1_contracts__contract_id__cost_get",
        "parameters": [
          {
            "in": "path",
            "name": "contract_id",
            "required": true,
            "schema": {
              "title": "Contract Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "by",
            "required": false,
            "schema": {
              "default": "namespace",
              "title": "By",
              "type": "string"
            }
          },
          {
            "description": "days ago",
            "in": "query",
            "name": "compare",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 400,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "days ago",
              "title": "Compare"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Allocation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cost"
      }
    },
    "/api/v1/contracts/{contract_id}/history": {
      "get": {
        "operationId": "history_api_v1_contracts__contract_id__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "contract_id",
            "required": true,
            "schema": {
              "title": "Contract Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cluster",
